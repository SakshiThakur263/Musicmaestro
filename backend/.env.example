PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/world_of_musicians
JWT_SECRET=wom_super_secret_jwt_key_2026
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Email Notifications (Contact & Booking Alerts)
ADMIN_EMAIL=musicmaestroevent@gmail.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password


# ---------------------------------------------------------------------------
# WhatsApp notifications (sent on every Artist / Client registration)
# Leave WHATSAPP_PROVIDER empty to only log messages to the console.
# ---------------------------------------------------------------------------
# Team numbers that get an alert for each new registration (comma separated)
ADMIN_WHATSAPP_NUMBERS=919009999434
WHATSAPP_DEFAULT_COUNTRY_CODE=91

# "meta" (WhatsApp Business Cloud API) or "twilio"
WHATSAPP_PROVIDER=

# --- Meta WhatsApp Cloud API ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANG=en
# Approved template names (required in production for business-initiated messages)
#   client/artist welcome body params: {{1}} = name, {{2}} = role
#   admin alert body params:           {{1}} = role, {{2}} = name, {{3}} = email, {{4}} = phone
WHATSAPP_TEMPLATE_CLIENT_WELCOME=
WHATSAPP_TEMPLATE_ARTIST_WELCOME=
WHATSAPP_TEMPLATE_ADMIN_ALERT=

# --- Twilio (alternative) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_CONTENT_SID_CLIENT_WELCOME=
TWILIO_CONTENT_SID_ARTIST_WELCOME=
TWILIO_CONTENT_SID_ADMIN_ALERT=

# Owner WhatsApp used in email buttons (free wa.me links)
OWNER_WHATSAPP_NUMBER=919009999434
# Optional paid API templates for booking inquiries
WHATSAPP_TEMPLATE_INQUIRY_CLIENT=
WHATSAPP_TEMPLATE_INQUIRY_ADMIN=
TWILIO_CONTENT_SID_INQUIRY_CLIENT=
TWILIO_CONTENT_SID_INQUIRY_ADMIN=
